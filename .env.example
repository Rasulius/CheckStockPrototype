# Подключение к PostgreSQL.
# Локальный запуск (БД из docker-compose, порт 5433 на хосте):
# PostgreSQL (по умолчанию)
DATABASE_URL=postgresql+psycopg://checkstock:checkstock@localhost:5433/checkstock

# SQLite (тестовый/облачный режим, без PostgreSQL)
# DATABASE_URL=sqlite:///./data/checkstock.db
#
# Внутри docker-compose приложение ходит к сервису db по внутреннему порту:
# DATABASE_URL=postgresql+psycopg://checkstock:checkstock@db:5432/checkstock
